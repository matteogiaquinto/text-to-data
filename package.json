{
  "name": "@matteogiaquinto/text-to-data",
  "version": "0.1.0",
  "description": "Provider-agnostic TypeScript library for extracting structured, validated data from natural language.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matteogiaquinto/text-to-data.git"
  },
  "homepage": "https://github.com/matteogiaquinto/text-to-data#readme",
  "bugs": {
    "url": "https://github.com/matteogiaquinto/text-to-data/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "pnpm build",
    "test": "vitest run",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format:check": "prettier --check .",
    "eval:ollama": "pnpm build && node scripts/eval-ollama.mjs"
  },
  "keywords": [
    "zod",
    "extraction",
    "structured-data",
    "local-models"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "^3.2.4"
  }
}
